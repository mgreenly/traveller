#!/bin/bash
# Remember the current directory
original_dir="$PWD"

# Change to the git repository root directory
cd "$(git rev-parse --show-toplevel)"

# Check that a commit message was provided
if [ -z "$1" ]; then
    echo "Error: main requires a commit message"
    echo "Usage: main Your commit message here"
    cd "$original_dir"
    exit 1
fi

# Concatenate all arguments into a single commit message
commit_message="$*"

# First run wip to ensure all changes are committed to wip branch
wip

# Switch to main branch
git checkout main

# Squash merge the wip branch into main (this brings all changes from wip into main as staged changes)
git merge --squash wip

# Commit the squashed changes with the provided message
git commit -m "$commit_message"

# Push the changes to github main
git push github main

# Switch back to wip branch
git checkout wip

# Reset wip branch to exactly match main (this makes wip identical to main)
git reset --hard main

# Return to the original directory
cd "$original_dir"
