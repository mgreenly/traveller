# .envrc
# Git workflow shortcuts for this project

# Create script-based commands in PATH
mkdir -p .direnv/bin

cat > .direnv/bin/gwip << 'EOF'
#!/bin/bash
git checkout -b wip
EOF

cat > .direnv/bin/gmain << 'EOF'
#!/bin/bash
git checkout main
EOF

cat > .direnv/bin/gsquash << 'EOF'
#!/bin/bash
git merge --squash wip
EOF

cat > .direnv/bin/gcommit << 'EOF'
#!/bin/bash
git commit -m "$1"
git push
EOF

cat > .direnv/bin/gclean << 'EOF'
#!/bin/bash
git branch -d wip
EOF

cat > .direnv/bin/grollback << 'EOF'
#!/bin/bash
current_branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$current_branch" = "wip" ]; then
    git reset --hard HEAD^
else
    echo "Error: grollback only works on the 'wip' branch. Currently on '$current_branch'"
    exit 1
fi
EOF

cat > .direnv/bin/gadd << 'EOF'
#!/bin/bash
current_branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$current_branch" = "wip" ]; then
    git add -A .
    git commit -m 'wip'
else
    echo "Error: gadd only works on the 'wip' branch. Currently on '$current_branch'"
    exit 1
fi
EOF

# Make them executable
chmod +x .direnv/bin/*

# Add to PATH
PATH_add .direnv/bin