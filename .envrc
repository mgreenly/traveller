# .envrc
# Git workflow shortcuts for this project

# Create script-based commands in PATH
mkdir -p .direnv/bin

cat > .direnv/bin/gwip << 'EOF'
#!/bin/bash
# Switch to wip branch if not already there
current_branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$current_branch" != "wip" ]; then
    git checkout wip 2>/dev/null || git checkout -b wip
fi

# If there are any changes, add and commit them
if ! git diff --quiet || ! git diff --cached --quiet; then
    git add -A .
    git commit -m 'wip'
fi

# Force push the wip branch to github
git push --force-with-lease github wip
EOF

cat > .direnv/bin/gmain << 'EOF'
#!/bin/bash
# First run gwip to save any current work
gwip

# Switch to main branch
git checkout main

# Squash merge the wip branch into main
git merge --squash wip

# Commit using the supplied comment
if [ -z "$1" ]; then
    echo "Error: gmain requires a commit message"
    echo "Usage: gmain 'Your commit message'"
    exit 1
fi
git commit -m "$1"

# Switch back to wip branch
git checkout wip

# Reset wip branch to match main
git reset --hard main
EOF

# Make them executable
chmod +x .direnv/bin/*

# Add to PATH
PATH_add .direnv/bin
