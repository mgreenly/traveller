# .envrc
# Git workflow shortcuts for this project

# Create script-based commands in PATH
mkdir -p .direnv/bin

cat > .direnv/bin/wip << 'EOF'
#!/bin/bash
# Remember the current directory
original_dir="$PWD"

# Change to the git repository root directory
cd "$(git rev-parse --show-toplevel)"

# Switch to wip branch if not already there
current_branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$current_branch" != "wip" ]; then
    git checkout wip 2>/dev/null || git checkout -b wip
fi

# Always add all changes from the git repository root, then check if there's anything to commit
git add -A

# If there are any staged changes, commit them
if ! git diff --cached --quiet; then
    git commit -m 'wip'
fi

# Force push the wip branch to github
git push --force-with-lease github wip

# Return to the original directory
cd "$original_dir"
EOF

cat > .direnv/bin/main << 'EOF'
#!/bin/bash
# Remember the current directory
original_dir="$PWD"

# Change to the git repository root directory
cd "$(git rev-parse --show-toplevel)"

# Check that a commit message was provided
if [ -z "$1" ]; then
    echo "Error: main requires a commit message"
    echo "Usage: main Your commit message here"
    cd "$original_dir"
    exit 1
fi

# Concatenate all arguments into a single commit message
commit_message="$*"

# First run wip to ensure all changes are committed to wip branch
wip

# Switch to main branch
git checkout main

# Squash merge the wip branch into main (this brings all changes from wip into main as staged changes)
git merge --squash wip

# Commit the squashed changes with the provided message
git commit -m "$commit_message"

# Push the changes to github main
git push github main

# Switch back to wip branch
git checkout wip

# Reset wip branch to exactly match main (this makes wip identical to main)
git reset --hard main

# Return to the original directory
cd "$original_dir"
EOF

# Make them executable
chmod +x .direnv/bin/*

# Add to PATH
PATH_add .direnv/bin
